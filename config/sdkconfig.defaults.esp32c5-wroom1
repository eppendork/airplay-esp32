# =============================================================================
# ESP32-C5-WROOM-1 target defaults
# =============================================================================

CONFIG_BOARD_ESP32C5_WROOM1=y

# Flash layout (8 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# PSRAM (8 MB, quad SPI)
CONFIG_SPIRAM=y

# Single-core scheduler
CONFIG_FREERTOS_UNICORE=y

# Console over the built-in USB Serial/JTAG (USB-C) for flashing + monitor
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Prefer the 5 GHz band when the network is available on both bands.
CONFIG_WIFI_PREFER_5GHZ=y

# =============================================================================
# GPIO defaults

CONFIG_LED_STATUS_GPIO=27
CONFIG_I2S_BCK_IO=8
CONFIG_I2S_WS_IO=9
CONFIG_I2S_DO_IO=10
